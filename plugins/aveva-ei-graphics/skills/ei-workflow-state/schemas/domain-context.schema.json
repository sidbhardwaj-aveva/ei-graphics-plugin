{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EI Graphics domain context",
  "description": "Domain context written by ei-vocabulary-navigator at the domain-context stage. Domain skills are detected by matching story text against the domain-skill-registry; each matched skill contributes a domainSkills entry with Key Files as candidate evidence for the scope resolver.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "storyId",
    "generatedAt",
    "domainSkills"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "enum": ["ei-domain-skill-registry"] },
    "storyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "domainSkills": {
      "type": "array",
      "description": "Domain-specific context injected from matching domain SKILL.md files. Each entry carries the domain knowledge and a Key Files section. Key files are candidate evidence, not automatic scope.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domainId", "displayName", "summary", "keyFiles", "keyFilesNote"],
        "properties": {
          "domainId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "summary": { "type": "string" },
          "keyFiles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "purpose"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "purpose": { "type": "string" }
              }
            }
          },
          "keyFilesNote": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EI Graphics workflow result contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workflow",
    "path",
    "storyId",
    "status",
    "stage",
    "stateDir",
    "summary",
    "artifacts",
    "gates",
    "blocks",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "workflow": { "type": "string", "enum": ["ei-graphics-workflow"] },
    "path": { "type": "string", "enum": ["IMPLEMENT", "ITERATE"] },
    "storyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "status": {
      "type": "string",
      "enum": ["completed", "awaiting-approval", "blocked", "failed"]
    },
    "stage": { "type": "string", "minLength": 1 },
    "stateDir": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "exists"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "exists": { "type": "boolean" }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "result", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "result": { "type": "string", "enum": ["pass", "block", "not-run"] },
          "detail": { "type": ["string", "null"] }
        }
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "stage", "message", "remediation", "raisedAt"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "stage": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "remediation": { "type": ["string", "null"] },
          "raisedAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nextAction": { "type": "string", "minLength": 1 }
  }
}

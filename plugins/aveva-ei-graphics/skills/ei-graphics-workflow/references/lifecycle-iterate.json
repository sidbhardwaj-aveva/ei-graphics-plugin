      "gate": "prerequisites",
      "implementedInPhase": "A"
    },
    {
      "id": "state-recovery",
      "name": "Workflow state and branch/PR recovery",
      "owner": "ei-workflow-state",
      "artifact": "workflow-state",
      "writesFiles": false,
      "gate": "state-integrity",
      "implementedInPhase": "A"
    },
    {
      "id": "scope-recovery",
      "name": "ApprovedScope recovery and hash verification",
      "owner": "ei-scope-validator",
      "artifact": "approved-scope",
      "writesFiles": false,
      "gate": "scope-hash",
      "implementedInPhase": "B"
    },
    {
      "id": "iteration-recovery",
      "name": "PR feedback and CI evidence recovery",
      "owner": "ei-graphics-workflow",
      "artifact": "iteration",
      "writesFiles": false,

{
  "schemaVersion": "1.0.0",
  "path": "ITERATE",
  "description": "Ordered ITERATE lifecycle owned by ei-graphics-workflow. It recovers the sealed ApprovedScope, never restarts intake, and never broadens scope without a new human approval.",
